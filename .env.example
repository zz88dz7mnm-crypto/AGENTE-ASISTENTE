# Copiar a .env.local y completar. .env* está en .gitignore: nunca se commitea.

# --- Web (Vercel + local) ---------------------------------------------------
# Estas dos viajan al navegador. Son públicas por diseño: lo que protege los
# datos es RLS + login, no el secreto de la clave.
NEXT_PUBLIC_SUPABASE_URL=https://znpnbuxmgatyjqtdpync.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZDhZitG4V048p39iWmyB4g_DpByNak9

# --- Rutina diaria de las 2 AM (sólo servidor) ------------------------------
# La service_role salta RLS. Va únicamente en el entorno de la Routine.
# NUNCA en Vercel como NEXT_PUBLIC_, ni en el repo.
SUPABASE_URL=https://znpnbuxmgatyjqtdpync.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
